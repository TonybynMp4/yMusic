{
  "name": "@ymusic/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:replay": "YMUSIC_REPLAY=${YMUSIC_REPLAY:-default} vite",
