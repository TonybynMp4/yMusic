{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
    },
    "apps/desktop": {
      // The Vite plugin finds main.tsx through index.html; the workers are
      // spawned by URL.
      "entry": ["src/*.worker.ts"],
      // CSS included so the Tailwind imports in styles.css count.
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    // Entries come from each package's `exports`, tests from the Vitest plugin.
    "packages/*": {
      "project": ["src/**/*.ts"],
    },
  },
  "ignoreIssues": {
    // shadcn components keep their full upstream API, so a later
    // `shadcn add` or diff against upstream stays clean.
    "apps/desktop/src/components/ui/*.tsx": ["exports", "types"],
  },
  "ignoreFiles": [
    // Kept for the theme setting in PLAN.md.
    "apps/desktop/src/components/ui/theme-switcher.tsx",
    // Kept for collaborative playlists.
    "apps/desktop/src/components/ui/avatar-stack.tsx",
  ],
}
