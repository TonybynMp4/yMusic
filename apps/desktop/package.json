    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@ymusic/core": "workspace:*",
    "@ymusic/ipc": "workspace:*",
    "@ymusic/youtube": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
