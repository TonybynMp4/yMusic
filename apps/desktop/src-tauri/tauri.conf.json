{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yMusic",
  "version": "0.1.0",
  "identifier": "dev.tony.ytbm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yMusic",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost img: http://img.localhost https://*.ytimg.com https://*.googleusercontent.com https://*.ggpht.com data:; media-src 'self' asset: http://asset.localhost https://*.googlevideo.com; connect-src 'self' ipc: http://ipc.localhost https://*.youtube.com https://*.googleapis.com; frame-src botguard: http://botguard.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libmpv2 | libmpv-dev",
          "libsecret-1-0"
        ],
        "section": "sound",
        "desktopTemplate": "packaging/ytbm.desktop"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
